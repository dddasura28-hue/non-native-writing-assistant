{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Non-native Writing Assistant",
  "version": "0.1.0",
  "identifier": "com.nonnativewriting.assistant",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Non-native Writing Assistant",
        "width": 1120,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": ["desktop-shell"],
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
