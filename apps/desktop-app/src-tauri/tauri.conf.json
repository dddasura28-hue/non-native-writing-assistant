{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Non-native Writing Assistant",
  "version": "0.1.0",
  "identifier": "com.nonnativewriting.assistant",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Non-native Writing Assistant",
        "width": 1120,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true
      },
      {
        "label": "global-assistant",
        "title": "Writing Assistance",
        "url": "index.html?surface=global-assistant",
        "width": 420,
        "height": 320,
        "minWidth": 340,
        "minHeight": 220,
        "maxWidth": 520,
        "maxHeight": 460,
        "resizable": true,
        "visible": false,
        "focus": false,
        "focusable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "capabilities": ["desktop-shell", "global-assistant"],
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
